{
  "$schema": "https://t3.codes/schema/t3.json",
  "defaultThreadEnvMode": "worktree",
  "worktreeSubmodules": "recursive",
  "scripts": [
    {
      "name": "Init submodules",
      "command": "git submodule update --init --recursive",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Configure",
      "command": "cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTS=ON -DCHATTERINO_UPDATER=OFF",
      "icon": "configure"
    },
    {
      "name": "Build",
      "command": "cmake --build build",
      "icon": "build"
    },
    {
      "name": "Slim tests",
      "command": "QT_QPA_PLATFORM=minimal build/bin/chatterino-test --gtest_filter='Slim*:InstanceServer*:Notebook*' && bash tests/slim/smoke.sh build/bin/chatterino",
      "icon": "test"
    }
  ]
}
